<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Серия и номер паспорта в одной строке -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Серия -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Серия"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1234"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="12dp"
                    android:background="@drawable/edit_text_background" />

            </LinearLayout>

            <!-- Номер -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Номер"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="123456"
                    android:inputType="number"
                    android:maxLength="6"
                    android:padding="12dp"
                    android:background="@drawable/edit_text_background" />

            </LinearLayout>

        </LinearLayout>

        <!-- Кем выдан -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кем выдан"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etIssuedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например: УФМС России по г. Москве"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edit_text_background" />

        <!-- Дата выдачи и код подразделения в одной строке -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Дата выдачи -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дата выдачи"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etIssueDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ДД.ММ.ГГГГ"
                    android:inputType="number"
                    android:maxLength="10"
                    android:padding="12dp"
                    android:background="@drawable/edit_text_background" />

            </LinearLayout>

            <!-- Код подразделения -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Код подразделения"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etDepartmentCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="123-456"
                    android:inputType="number"
                    android:maxLength="7"
                    android:padding="12dp"
                    android:background="@drawable/edit_text_background" />

            </LinearLayout>

        </LinearLayout>

        <!-- Дата рождения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дата рождения"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ДД.ММ.ГГГГ"
            android:inputType="number"
            android:maxLength="10"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edit_text_background" />

        <!-- Место рождения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Место рождения"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etBirthPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например: г. Москва"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:background="@drawable/edit_text_background" />

    </LinearLayout>

</ScrollView>